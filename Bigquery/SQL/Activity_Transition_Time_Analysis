SELECT
  activity,
  next_activity,
  COUNT(*) AS transition_count,
  ROUND(AVG(transition_minutes), 2) AS avg_transition_minutes
FROM (
  SELECT
    case_id,
    activity,
    LEAD(activity) OVER (
      PARTITION BY case_id
      ORDER BY event_order
    ) AS next_activity,
    TIMESTAMP_DIFF(
      LEAD(timestamp) OVER (
        PARTITION BY case_id
        ORDER BY event_order
      ),
      timestamp,
      MINUTE
    ) AS transition_minutes
  FROM `care-flow-clinical-pathway.careflow_dataset.care-flow-clinical-pathway- process- mining`
) AS ordered_events
WHERE next_activity IS NOT NULL
  AND transition_minutes IS NOT NULL
GROUP BY activity, next_activity
ORDER BY avg_transition_minutes DESC;
